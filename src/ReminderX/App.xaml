<Application x:Class="ReminderX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ReminderX.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="ColorsDictionary" Source="Themes/Colors.Light.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis"/>
            <conv:NullToVisibilityConverter x:Key="NotNullToVis" Invert="True"/>
            <conv:CountToVisibilityConverter x:Key="CountToVis"/>
            <conv:FriendlyDateConverter x:Key="FriendlyDate"/>
            <conv:ReminderStateToBrushKeyConverter x:Key="StateToBrushKey"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
