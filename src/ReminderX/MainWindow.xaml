<Window x:Class="ReminderX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:ReminderX.Views"
        Title="ReminderX"
        Icon="/Assets/reminderx.ico"
        Width="960" Height="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        ResizeMode="CanResize"
        MinWidth="760" MinHeight="520"
        FontFamily="{StaticResource Font.Text}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock Text="ReminderX" Style="{StaticResource Text.Heading}" Margin="16,0,0,0"
                       VerticalAlignment="Center" Opacity="0.75"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource Button.Icon}" Click="Minimize_Click" ToolTip="Minimize to tray"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                </Button>
                <Button Style="{StaticResource Button.Icon}" Click="Maximize_Click" ToolTip="Maximize"
                        x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                </Button>
                <Button Style="{StaticResource Button.Icon}" Click="Close_Click" ToolTip="Close (keeps running in tray)"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
                </Button>
            </StackPanel>
        </Grid>

            <!-- Body -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}">
                    <StackPanel Margin="12,6,12,12">
                        <RadioButton x:Name="NavReminders" Style="{StaticResource Button.NavItem}" GroupName="Nav"
                                     Checked="NavReminders_Checked" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="Reminders"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTodo" Style="{StaticResource Button.NavItem}" GroupName="Nav"
                                     Checked="NavTodo_Checked" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="To-Do"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource Button.NavItem}" GroupName="Nav"
                                     Checked="NavHistory_Checked" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="History"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Button.NavItem}" GroupName="Nav"
                                     Checked="NavSettings_Checked" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="24,20,24,20">
                    <views:RemindersView x:Name="RemindersPanel"/>
                    <views:TodoView x:Name="TodoPanel" Visibility="Collapsed"/>
                    <views:HistoryView x:Name="HistoryPanel" Visibility="Collapsed"/>
                    <views:SettingsView x:Name="SettingsPanel" Visibility="Collapsed"/>
                </Grid>
            </Grid>
    </Grid>
</Window>
