<Window x:Class="ReminderX.Views.PairPhoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Link a phone"
        Icon="/Assets/reminderx.ico"
        Width="440" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,0,8,0">
            <TextBlock Text="Link a phone" Style="{StaticResource Text.Heading}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource Button.Icon}" Click="Close_Click" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="28,0,28,0">
            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,4">
                <Run Text="1. Install ReminderX on your Android phone ("/><Hyperlink x:Name="ApkLink" Click="ApkLink_Click"><Run Text="download the APK"/></Hyperlink><Run Text=")."/>
            </TextBlock>
            <TextBlock Text="2. Open it and scan this code." Style="{StaticResource Text.Body}" Margin="0,0,0,16"/>

            <Border Background="White" CornerRadius="16" Padding="16" HorizontalAlignment="Center">
                <Grid Width="280" Height="280">
                    <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    <TextBlock x:Name="QrPlaceholder" Text="Creating a code…" Foreground="#6E6E73"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" FontSize="12.5"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0"/>
            <TextBlock Text="Reminders and to-dos travel end-to-end encrypted. The code works once and expires in 10 minutes."
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="NewCodeButton" Content="New code" Style="{StaticResource Button.Secondary}"
                        Click="NewCode_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="DoneButton" Content="Close" Style="{StaticResource Button.Secondary}" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
