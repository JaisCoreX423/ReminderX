<Window x:Class="ReminderX.Views.ReminderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Reminder"
        Icon="/Assets/reminderx.ico"
        Width="460" Height="700"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        ResizeMode="NoResize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock x:Name="HeaderText" Text="New Reminder" Style="{StaticResource Text.Heading}"
                       Margin="18,0,0,0" VerticalAlignment="Center"/>
            <Button Style="{StaticResource Button.Icon}" Click="Cancel_Click" HorizontalAlignment="Right" Margin="0,0,8,0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
            </Button>
        </Grid>

            <ScrollViewer Grid.Row="1" Padding="20,0,20,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="TITLE" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleBox" FontSize="15" Padding="10,9"/>

                    <TextBlock Text="DESCRIPTION" Style="{StaticResource Text.Caption}" Margin="0,14,0,4"/>
                    <TextBox x:Name="DescriptionBox" Height="64" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="TYPE" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="OneTimeRadio" Content="One-time" GroupName="Type" IsChecked="True"
                                     Checked="TypeChanged" Margin="0,0,20,0" Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <RadioButton x:Name="RecurringRadio" Content="Recurring" GroupName="Type"
                                     Checked="TypeChanged" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </StackPanel>

                    <!-- One-time -->
                    <StackPanel x:Name="OneTimePanel" Margin="0,14,0,0">
                        <TextBlock Text="DATE &amp; TIME" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker x:Name="DueDatePicker" Grid.Column="0"/>
                            <ComboBox x:Name="DueTimeCombo" Grid.Column="2"/>
                        </Grid>
                    </StackPanel>

                    <!-- Recurring -->
                    <StackPanel x:Name="RecurringPanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <TextBlock Text="REPEAT EVERY" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IntervalBox" Grid.Column="0" Text="1" HorizontalContentAlignment="Center"/>
                            <ComboBox x:Name="UnitCombo" Grid.Column="2" SelectionChanged="UnitCombo_SelectionChanged"/>
                        </Grid>

                        <StackPanel x:Name="TimeOfDayPanel" Margin="0,12,0,0">
                            <TextBlock Text="AT" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="RecurTimeCombo" HorizontalAlignment="Left" Width="140"/>
                        </StackPanel>

                        <StackPanel x:Name="WeekdaysPanel" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock Text="ON DAYS" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <WrapPanel x:Name="WeekdaysPicker">
                                <ToggleButton Content="Su" Tag="Sunday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                                <ToggleButton Content="Mo" Tag="Monday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                                <ToggleButton Content="Tu" Tag="Tuesday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                                <ToggleButton Content="We" Tag="Wednesday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                                <ToggleButton Content="Th" Tag="Thursday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                                <ToggleButton Content="Fr" Tag="Friday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                                <ToggleButton Content="Sa" Tag="Saturday" Width="40" Height="32" Margin="0,0,6,6" Style="{StaticResource DayToggle}"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="START" Style="{StaticResource Text.Caption}" Margin="0,0,0,4"/>
                            <DatePicker x:Name="RecurStartDatePicker" HorizontalAlignment="Left" Width="160"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="RE-NOTIFY IF IGNORED (MINUTES, 0 = OFF)" Style="{StaticResource Text.Caption}" Margin="0,16,0,4"/>
                    <TextBox x:Name="RenotifyBox" Text="10" Width="80" HorizontalAlignment="Left" HorizontalContentAlignment="Center"/>

                    <TextBlock Text="ATTACHMENTS" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <ItemsControl x:Name="AttachmentsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="6" ClipToBounds="True" Background="#22000000">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource Text.Body}"
                                                   VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Width="26" Height="26"
                                                Click="RemoveAttachment_Click">
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="+ Add attachment" Style="{StaticResource Button.Secondary}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="AddAttachment_Click"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Button Content="Cancel" Style="{StaticResource Button.Secondary}" Click="Cancel_Click" Margin="0,0,10,0"/>
                    <Button Content="Save" Style="{StaticResource Button.Primary}" Click="Save_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>
    </Grid>
</Window>
