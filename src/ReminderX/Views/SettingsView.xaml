<UserControl x:Class="ReminderX.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource Text.Title}" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SettingsStack" MaxWidth="560" HorizontalAlignment="Left">

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource Text.Heading}" Margin="0,0,0,10"/>

                        <Grid Margin="0,6,0,0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Appearance" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="System follows your Windows theme." Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="2" CornerRadius="8"
                                    Background="{DynamicResource Brush.SurfaceAlt}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" Content="System" GroupName="Theme" Tag="System"
                                                 Style="{StaticResource Segment}" Click="Theme_Click"/>
                                    <RadioButton x:Name="ThemeLight" Content="Light" GroupName="Theme" Tag="Light"
                                                 Style="{StaticResource Segment}" Click="Theme_Click"/>
                                    <RadioButton x:Name="ThemeDark" Content="Dark" GroupName="Theme" Tag="Dark"
                                                 Style="{StaticResource Segment}" Click="Theme_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Runs ReminderX in the tray at logon." Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="StartWithWindowsCheck_Click"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Full-screen alerts" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Dims the screen and shows the reminder in the middle. Off uses a regular Windows notification."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Preview" Style="{StaticResource Button.Secondary}"
                                    Padding="12,5" Margin="0,0,14,0" VerticalAlignment="Center" Click="PreviewAlert_Click"/>
                            <CheckBox Grid.Column="2" x:Name="FullScreenAlertsCheck" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Click="FullScreenAlertsCheck_Click"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Notification sound" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Play a chime when a reminder appears." Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                            <CheckBox x:Name="SoundCheck" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="SoundCheck_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Review Outlook &amp; Teams" Style="{StaticResource Text.Heading}" Margin="0,0,0,4"/>
                        <TextBlock Text="The Today and Last days buttons on Reminders ask Claude Code to read your email, calendar and Teams chats (read-only) and suggest reminders you don't have yet. Needs Claude Code signed in with the Microsoft 365 connector."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <Grid>
                            <TextBlock Text="Look back" VerticalAlignment="Center" Style="{StaticResource Text.Body}"/>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="2" CornerRadius="8"
                                    Background="{DynamicResource Brush.SurfaceAlt}">
                                <StackPanel x:Name="ReviewDaysSegments" Orientation="Horizontal">
                                    <RadioButton Content="1 day" GroupName="ReviewDays" Tag="1"
                                                 Style="{StaticResource Segment}" Click="ReviewDays_Click"/>
                                    <RadioButton Content="3 days" GroupName="ReviewDays" Tag="3"
                                                 Style="{StaticResource Segment}" Click="ReviewDays_Click"/>
                                    <RadioButton Content="7 days" GroupName="ReviewDays" Tag="7"
                                                 Style="{StaticResource Segment}" Click="ReviewDays_Click"/>
                                    <RadioButton Content="14 days" GroupName="ReviewDays" Tag="14"
                                                 Style="{StaticResource Segment}" Click="ReviewDays_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="AI access (MCP server)" Style="{StaticResource Text.Heading}" Margin="0,0,0,4"/>
                        <TextBlock Text="Lets an MCP-compatible AI client (Claude Code, Claude Desktop) list and create reminders and to-dos while ReminderX is running. Local machine only."
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Enable MCP server" Style="{StaticResource Text.Body}"/>
                                <TextBlock x:Name="McpStatusText" Text="" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                            <CheckBox x:Name="McpEnabledCheck" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" Click="McpEnabledCheck_Click"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Port" VerticalAlignment="Center" Style="{StaticResource Text.Body}"/>
                            <TextBox Grid.Column="2" x:Name="PortBox"/>
                            <Button Grid.Column="4" Content="Apply" Style="{StaticResource Button.Secondary}" Click="ApplyPort_Click"/>
                        </Grid>

                        <TextBlock x:Name="ClaudeStatusText" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"
                                   TextWrapping="Wrap"/>

                        <!-- Only when Claude doesn't point at this port (port changed, or never connected) -->
                        <StackPanel x:Name="ClaudeConnectPanel" Visibility="Collapsed">
                            <TextBlock Text="CONNECT FROM CLAUDE CODE" Style="{StaticResource Text.Caption}" Margin="0,12,0,4"/>
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="10">
                                <TextBlock x:Name="McpCommandText" Style="{StaticResource Text.Body}" FontFamily="Consolas"
                                           TextWrapping="Wrap"/>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="ReconnectButton" Content="Reconnect Claude" Style="{StaticResource Button.Primary}"
                                        Click="ReconnectClaude_Click" Margin="0,0,8,0"
                                        ToolTip="Points Claude Desktop and Claude Code at this port"/>
                                <Button Content="Copy command" Style="{StaticResource Button.Secondary}" Click="CopyCommand_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="About" Style="{StaticResource Text.Heading}" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/Assets/reminderx-256.png" Width="48" Height="48" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Heading}" FontSize="15">
                                    <Run Text="ReminderX"/>
                                    <Run x:Name="VersionRun" Text="" Foreground="{DynamicResource Brush.TextSecondary}" FontWeight="Normal"/>
                                </TextBlock>
                                <TextBlock x:Name="CreditsText" Style="{StaticResource Text.Body}" Margin="0,2,0,0"/>
                                <Button x:Name="RepoLinkButton" Style="{StaticResource Button.Link}" Padding="0,2"
                                        HorizontalAlignment="Left" Margin="0,2,0,0" Click="RepoLink_Click"
                                        Foreground="{DynamicResource Brush.Accent}"/>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,16,0,14"/>

                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Text="Install updates automatically" Style="{StaticResource Text.Body}"/>
                                <TextBlock Text="Checks GitHub for new releases every 6 hours and installs them while ReminderX is idle in the tray."
                                           Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="AutoUpdateCheck" Style="{StaticResource ToggleSwitch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Click="AutoUpdateCheck_Click"/>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource Text.Caption}" FontSize="12.5"
                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <Button Grid.Column="1" x:Name="InstallUpdateButton" Style="{StaticResource Button.Primary}"
                                    Padding="12,5" Margin="0,0,8,0" Visibility="Collapsed" Click="InstallUpdate_Click"/>
                            <Button Grid.Column="2" x:Name="CheckUpdatesButton" Content="Check now"
                                    Style="{StaticResource Button.Secondary}" Padding="12,5" Click="CheckUpdates_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Data" Style="{StaticResource Text.Heading}" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open data folder" Style="{StaticResource Button.Secondary}" Click="OpenDataFolder_Click" Margin="0,0,10,0"/>
                            <Button Content="Open log file" Style="{StaticResource Button.Secondary}" Click="OpenLog_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
