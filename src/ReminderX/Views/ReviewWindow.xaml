<Window x:Class="ReminderX.Views.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Review Outlook &amp; Teams"
        Icon="/Assets/reminderx.ico"
        Width="560" Height="660"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Background="{DynamicResource Brush.Window}"
        ResizeMode="NoResize"
        FontFamily="{StaticResource Font.Text}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="64"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="20,0,8,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Review Outlook &amp; Teams" Style="{StaticResource Text.Heading}"/>
                <TextBlock x:Name="ScopeText" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <Button Style="{StaticResource Button.Icon}" Click="Close_Click" HorizontalAlignment="Right"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="11"/>
            </Button>
        </Grid>

        <!-- Working -->
        <StackPanel x:Name="BusyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0">
            <TextBlock Text="&#xE715;" FontFamily="Segoe Fluent Icons" FontSize="34" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.Accent}"/>
            <TextBlock Text="Claude is reading your Outlook and Teams…" Style="{StaticResource Text.Heading}"
                       HorizontalAlignment="Center" Margin="0,16,0,6"/>
            <TextBlock Text="This usually takes 1 to 3 minutes. Nothing is created until you choose. You can close this window: the review keeps running and ReminderX notifies you when it finds something."
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="ElapsedText" Text="0:00" Style="{StaticResource Text.Title}" FontSize="28"
                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
        </StackPanel>

        <!-- Suggestions -->
        <Grid x:Name="ResultsPanel" Grid.Row="1" Visibility="Collapsed" Margin="20,4,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="0,0,0,10"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="SuggestionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource CheckCircle}" VerticalAlignment="Top" Margin="0,1,12,0"
                                              IsChecked="{Binding Selected, Mode=TwoWay}" Click="Selection_Changed"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Body}" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding DueAt, Converter={StaticResource FriendlyDate}}"
                                                   Style="{StaticResource Text.Caption}" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Caption}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Nothing found / error / done -->
        <StackPanel x:Name="MessagePanel" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="40,0">
            <TextBlock x:Name="MessageTitle" Style="{StaticResource Text.Heading}" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="MessageBody" Style="{StaticResource Text.Caption}" FontSize="12.5" Margin="0,8,0,0"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <Grid Grid.Row="2" Background="{DynamicResource Brush.SurfaceAlt}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="Check automatically" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="AutoReviewCombo" Width="130" SelectionChanged="AutoReviewCombo_Changed"
                          ToolTip="Checks what's new since the last review in the background (7 AM to 8 PM) and notifies you about new things"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource Button.Secondary}"
                        Click="Stop_Click" Margin="0,0,10,0" Visibility="Collapsed"/>
                <Button x:Name="SecondaryButton" Content="Cancel" Style="{StaticResource Button.Secondary}"
                        Click="Close_Click" Margin="0,0,10,0"/>
                <Button x:Name="CreateButton" Content="Create selected" Style="{StaticResource Button.Primary}"
                        Click="Create_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
